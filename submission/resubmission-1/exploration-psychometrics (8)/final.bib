	keywords = {Reinforcement learning, Bandit tasks, Dynamic environments, Loss aversion, Sequential decision making},
	pages = {151--164},
	file = {Full Text PDF:C\:\\Users\\Mirko\\Zotero\\storage\\MM5ZDI73\\Navarro et al. - 2018 - Aversion to Option Loss in a Restless Bandit Task.pdf:application/pdf},
}


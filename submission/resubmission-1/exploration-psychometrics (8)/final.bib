	issn = {2522-087X},
	url = {https://doi.org/10.1007/s42113-024-00202-y},
	doi = {10.1007/s42113-024-00202-y},
	abstract = {A key feature of animal and human decision-making is to balance the exploration of unknown options for information gain (directed exploration) versus selecting known options for immediate reward (exploitation), which is often examined using restless bandit tasks. Recurrent neural network models (RNNs) have recently gained traction in both human and systems neuroscience work on reinforcement learning, due to their ability to show meta-learning of task domains. Here we comprehensively compared the performance of a range of RNN architectures as well as human learners on restless four-armed bandit problems. The best-performing architecture (LSTM network with computation noise) exhibited human-level performance. Computational modeling of behavior first revealed that both human and RNN behavioral data contain signatures of higher-order perseveration, i.e., perseveration beyond the last trial, but this effect was more pronounced in RNNs. In contrast, human learners, but not RNNs, exhibited a positive effect of uncertainty on choice probability (directed exploration). RNN hidden unit dynamics revealed that exploratory choices were associated with a disruption of choice predictive signals during states of low state value, resembling a win-stay-loose-shift strategy, and resonating with previous single unit recording findings in monkey prefrontal cortex. Our results highlight both similarities and differences between exploration behavior as it emerges in meta-learning RNNs, and computational mechanisms identified in cognitive and systems neuroscience work.},
	language = {en},
	number = {3},
	urldate = {2024-09-25},
	journal = {Computational Brain \& Behavior},
	author = {Tuzsus, D. and Brands, A. and Pappas, I. and Peters, J.},
	month = sep,
	year = {2024},
	keywords = {Exploration-exploitation trade-off, Multi-armed bandit task, Artificial Intelligence, Computational modeling of behavior, Meta-reinforcement learning, Recurrent neural networks},
	pages = {314--356},
	file = {Full Text PDF:C\:\\Users\\Mirko\\Zotero\\storage\\3L8A3SSE\\Tuzsus et al. - 2024 - Exploration–Exploitation Mechanisms in Recurrent N.pdf:application/pdf},

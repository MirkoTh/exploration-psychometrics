@article{navarro_learning_2016,
	title = {Learning and choosing in an uncertain world: {An} investigation of the explore–exploit dilemma in static and dynamic environments},
	volume = {85},
	issn = {00100285},
	shorttitle = {Learning and choosing in an uncertain world},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0010028516000025},
	doi = {10.1016/j.cogpsych.2016.01.001},
	abstract = {How do people solve the explore–exploit trade-off in a changing environment? In this paper we present experimental evidence from an ‘‘observe or bet” task, in which people have to determine when to engage in information-seeking behavior and when to switch to reward-taking actions. In particular we focus on the comparison between people’s behavior in a changing environment and their behavior in an unchanging one. Our experimental work is motivated by rational analysis of the problem that makes strong predictions about information search and reward seeking in static and changeable environments. Our results show a striking agreement between human behavior and the optimal policy, but also highlight a number of systematic differences. In particular, we ﬁnd that while people often employ suboptimal strategies the ﬁrst time they encounter the learning problem, most people are able to approximate the correct strategy after minimal experience. In order to describe both the manner in which people’s choices are similar to but slightly different from an optimal standard, we introduce four process models for the observe or bet task and evaluate them as potential theories of human behavior.},
	language = {en},
	urldate = {2022-03-10},
	journal = {Cognitive Psychology},
	author = {Navarro, Daniel J. and Newell, Ben R. and Schulze, Christin},
	month = mar,
	year = {2016},
	pages = {43--77},
	file = {Navarro et al. - 2016 - Learning and choosing in an uncertain world An in.pdf:C\:\\Users\\Mirko\\Zotero\\storage\\CUQUXRI3\\Navarro et al. - 2016 - Learning and choosing in an uncertain world An in.pdf:application/pdf},
}

@article{dubois_human_2021,
	title = {Human complex exploration strategies are enriched by noradrenaline-modulated heuristics},
	volume = {10},
	issn = {2050-084X},
	url = {https://elifesciences.org/articles/59907},
	doi = {10.7554/eLife.59907},
	abstract = {An exploration-exploitation trade-off, the arbitration between sampling a lesser-known against a known rich option, is thought to be solved using computationally demanding exploration algorithms. Given known limitations in human cognitive resources, we hypothesised the presence of additional cheaper strategies. We examined for such heuristics in choice behaviour where we show this involves a value-free random exploration, that ignores all prior knowledge, and a novelty exploration that targets novel options alone. In a double-blind, placebo-controlled drug study, assessing contributions of dopamine (400 mg amisulpride) and noradrenaline (40 mg propranolol), we show that value-free random exploration is attenuated under the influence of propranolol, but not under amisulpride. Our findings demonstrate that humans deploy distinct computationally cheap exploration strategies and that value-free random exploration is under noradrenergic control.},
	language = {en},
	urldate = {2022-02-24},
	journal = {eLife},
	author = {Dubois, Magda and Habicht, Johanna and Michely, Jochen and Moran, Rani and Dolan, Ray J and Hauser, Tobias U},
	month = jan,
	year = {2021},
	pages = {e59907},

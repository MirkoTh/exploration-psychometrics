	doi = {10.32470/CCN.2019.1335-0},
	abstract = {The Kalman ﬁlter, combined with heuristic choice rules such as softmax, UCB, and Thompson sampling, has been a popular model to identify the role of uncertainty in exploration in human reinforcement learning. Here we show that the Kalman ﬁlter combined with a softmax or UCB choice rule is not fully identiﬁable. By this structural identiﬁability, we mean that with unlimited data, the true parameter values are determinable. Perhaps surprisingly, the Kalman ﬁlter with Thompson sampling is fully identiﬁable.},
	language = {en},
